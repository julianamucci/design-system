{
  "name": "nortear-design-system-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "pretest": "node ../scripts/limpar-orfaos.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6009",
    "build-storybook": "storybook build && node ../scripts/generate-seo-files.mjs --base https://vanilla.norteardesign.com.br --out storybook-static && node ../scripts/minify-html.mjs --out storybook-static",
    "chromatic": "npx chromatic",
    "build-storybook:chromatic": "storybook build"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@tanstack/table-core": "^9.1.2",
    "@tanstack/virtual-core": "^3.17.6",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-mathematics": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "embla-carousel": "^8.6.0",
    "katex": "0.18.4",
    "lucide": "^1.27.0",
    "motion": "^13.1.1",
    "quill": "^2.0.3",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/html-vite": "^10.5.5",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "playwright": "^1.62.0",
    "storybook": "^10.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
