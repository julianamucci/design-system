{
  "name": "nortear-design-system-vanilla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "pretest": "node ../scripts/limpar-orfaos.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run chat-docs && storybook dev -p 6009",
    "build-storybook": "npm run chat-docs && storybook build && node ../scripts/generate-seo-files.mjs --base https://vanilla.norteardesign.com.br --out storybook-static && node ../scripts/minify-html.mjs --out storybook-static",
    "chromatic": "npx chromatic",
    "build-storybook:chromatic": "npm run chat-docs && storybook build",
    "chat-docs": "vite build --config vite.chat-docs.config.ts"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.8",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-highlight": "3.32.1",
    "@tiptap/extension-image": "3.32.1",
    "@tiptap/extension-mathematics": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-task-item": "3.32.1",
    "@tiptap/extension-task-list": "3.32.1",
    "@tiptap/extension-text-align": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "embla-carousel": "^8.6.0",
    "katex": "0.19.1",
    "lucide": "^1.63.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^13.1.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "storybook": "^10.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
