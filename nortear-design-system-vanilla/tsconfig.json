{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../docs/shared/*"],
      // Os pacotes npm que o CONTEÚDO COMPARTILHADO importa. O `tsc` resolve do
      // mesmo jeito que o bundler — parte do arquivo em `docs/shared` e SOBE —,
      // então sem estes `paths` ele reprova com TS2307 em código que existe.
      // Contraparte de `resolve.alias` no vite.config; ver o porquê medido em
      // `docs/shared/bundler/alias-pacotes.mjs`.
      "mdast-util-from-markdown": ["./node_modules/mdast-util-from-markdown/index.d.ts"],
      "mdast-util-gfm": ["./node_modules/mdast-util-gfm/index.d.ts"],
      "micromark-extension-gfm": ["./node_modules/micromark-extension-gfm/index.d.ts"]
    }
  },
  // `api/**` entra porque a Vercel Function do chat de documentação não é
  // alcançada por portão nenhum de outra forma: ela não é story, não é docs
  // page e não é bundlada pelo Storybook. Sem esta linha o `tsc` passaria verde
  // por não abrir o arquivo — o defeito descrito na regra "portão só vale
  // depois de saber o que ele cobre".
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "api/**/*.ts",
    "vite.config.ts",
    "vite.chat-docs.config.ts",
    "../scripts/**/*"
  ]
}
