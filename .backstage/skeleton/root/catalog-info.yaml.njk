apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ values.projectName }}
  title: ${{ values.displayName }}
  description: ${{ values.description }}
  annotations:
    github.com/project-slug: ${{ values.repoUrl | replace("https://github.com/", "") }}
    backstage.io/techdocs-ref: dir:.
  tags:
    - design-system
    - frontend
    - storybook
{% for stack in values.stacks %}
    - ${{ stack }}
{% endfor %}
  links:
{% for stack in values.stacks %}
    - url: https://your-storybook-url/{{ stack }}
      title: Storybook — {{ stack }}
      icon: dashboard
{% endfor %}

spec:
  type: library
  lifecycle: production
  owner: ${{ values.owner }}
  system: frontend-platform
