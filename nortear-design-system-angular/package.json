{
  "name": "nortear-design-system-angular",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "ngc --noEmit -p .storybook/tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "pretest": "node ../scripts/limpar-orfaos.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build && node ../scripts/generate-seo-files.mjs --base https://angular.norteardesign.com.br --out storybook-static && node ../scripts/minify-html.mjs --out storybook-static",
