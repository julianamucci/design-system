{
  "name": "nortear-design-system-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "storybook": "npm run chat-docs && storybook dev -p 6006",
    "build-storybook": "npm run chat-docs && storybook build && node ../scripts/generate-seo-files.mjs --base https://react.norteardesign.com.br --out storybook-static && node ../scripts/minify-html.mjs --out storybook-static",
    "pretest": "node ../scripts/limpar-orfaos.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "chromatic": "npx chromatic",
    "postinstall": "patch-package",
    "build-storybook:chromatic": "npm run chat-docs && storybook build",
    "chat-docs": "vite build --config vite.chat-docs.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
