    "@tanstack/react-virtual": "^3.14.23",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-highlight": "3.32.1",
    "@tiptap/extension-image": "3.32.1",
    "@tiptap/extension-mathematics": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-task-item": "3.32.1",
    "@tiptap/extension-task-list": "3.32.1",
    "@tiptap/extension-text-align": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "0.19.1",
    "lucide-react": "^1.63.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "motion": "^13.1.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-resizable-panels": "^4.15.1",
    "sonner": "^2.0.7",
    "tslib": "^2.8.1",
    "vaul": "^1.1.2",
    "zustand": "^5.0.16"
