    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "lucide": "^1.63.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.64.1",
    "storybook": "^10.5.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
