{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../docs/shared/*"],
      // Os pacotes npm que o CONTEÚDO COMPARTILHADO importa. O `tsc` resolve do
      // mesmo jeito que o bundler — parte do arquivo em `docs/shared` e SOBE —,
      // então sem estes `paths` ele reprova com TS2307 em código que existe.
      // Contraparte de `resolve.alias` no vite.config; ver o porquê medido em
      // `docs/shared/bundler/alias-pacotes.mjs`.
      "mdast-util-from-markdown": ["./node_modules/mdast-util-from-markdown/index.d.ts"],
      "mdast-util-gfm": ["./node_modules/mdast-util-gfm/index.d.ts"],
      "micromark-extension-gfm": ["./node_modules/micromark-extension-gfm/index.d.ts"]
    }
  },
  // A pasta do Storybook entra pelo mesmo motivo que `src`: é código que o
  // projeto entrega. É nela que mora o listener de canal da toolbar de tema, e
  // sem ela um erro de tipo ali passava pelo build sem uma palavra.
  "include": ["src", ".storybook/**/*.ts"]
}
