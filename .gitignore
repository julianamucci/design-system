# Dependencies
node_modules/
.pnp
.pnp.js

# Sandbox de teste da CLI Nortear (gerado por mão, transitório)
.nortear-cli-test/

# Scratch do /pipeline (context-cache e scans) — inteiramente transitório.
# Nada aqui é versionado: a exceção que mantinha audit-prompts/ no git guardava
# templates de auditoria que ninguém invocava e cujo early-exit dava 10/10 para
# todo componente, porque esperavam um formato de scan que o audit.mjs não produz.
.pipeline-context/

# Testing
coverage/

# Production
dist/
build/
storybook-static/

# TypeScript build artifacts
*.tsbuildinfo

# Environment — valores reais ficam locais; versione apenas .env.example
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Storybook
.storybook-static/

# Log de diagnóstico do próprio Storybook: ele despeja aqui a saída quando o
# dev server ou o build quebra. É de uma rodada e de uma versão — os que
# estavam versionados guardavam rastro de pilha do Storybook 10.3.5, quatro
# menores atrás do instalado. O padrão cobre debug- e build-storybook.log; o
# .gitignore do react já trazia esta regra, e as outras quatro stacks não têm
# .gitignore próprio, então ela mora aqui para valer nas cinco.
*storybook.log

# Tarball do @nortear/ds-core (npm run core:pack)
nortear-ds-core-*.tgz

# AI/Cache
.gemini/
.claude/settings.local.json
.claude/plans/
.claude/worktrees/
.claude/scheduled_tasks.lock
.history/
scratch/

# Diário da revisão serial — local, não versionado
.revisao/
