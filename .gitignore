# Dependencies
node_modules/
.pnp
.pnp.js

# Logs — nada de log é versionado.
#
# Cobre duas coisas que já morderam. O despejo de crash do Storybook
# (debug-storybook.log) esteve versionado em vue, svelte e vanilla guardando
# rastro de pilha do 10.3.5, quatro menores atrás do instalado. E o log de
# falha de instalador (npm/yarn/pnpm), que até aqui só o .gitignore do react
# pegava — as outras quatro stacks não têm .gitignore próprio, e instalador
# falhando neste repositório não é hipótese.
*.log

# Sandbox de teste da CLI Nortear (gerado por mão, transitório)
.nortear-cli-test/

# Scratch do /pipeline (context-cache e scans) — inteiramente transitório.
# Nada aqui é versionado: a exceção que mantinha audit-prompts/ no git guardava
# templates de auditoria que ninguém invocava e cujo early-exit dava 10/10 para
# todo componente, porque esperavam um formato de scan que o audit.mjs não produz.
.pipeline-context/

# Testing
coverage/

# Production
dist/
build/
storybook-static/

# TypeScript build artifacts
*.tsbuildinfo

# Environment — valores reais ficam locais; versione apenas .env.example
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Convenção do Vite para arquivo só-local (o .env.local acima é o caso comum,
# mas o padrão vale para qualquer um).
*.local

