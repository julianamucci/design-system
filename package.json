{
  "name": "nortear-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "validate:docs": "npx tsx scripts/validate-docs-consistency.ts",
    "audit:content": "node scripts/audit-translation-literals.mjs",
    "core:pack": "npm pack ./docs/shared",
    "patches:list": "node scripts/list-patches.mjs",
    "storybook:angular": "npm run storybook --prefix nortear-design-system-angular",
    "storybook:react": "npm run storybook --prefix nortear-design-system-react",
    "storybook:vue": "npm run storybook --prefix nortear-design-system-vue",
    "storybook:svelte": "npm run storybook --prefix nortear-design-system-svelte",
    "storybook:vanilla": "npm run storybook --prefix nortear-design-system-vanilla",
    "chromatic:react": "npm run chromatic --prefix nortear-design-system-react",
    "chromatic:vue": "npm run chromatic --prefix nortear-design-system-vue",
    "chromatic:svelte": "npm run chromatic --prefix nortear-design-system-svelte",
    "chromatic:vanilla": "npm run chromatic --prefix nortear-design-system-vanilla",
    "chromatic:angular": "npm run chromatic --prefix nortear-design-system-angular",
    "chromatic:all": "npm run chromatic:react && npm run chromatic:vue && npm run chromatic:svelte && npm run chromatic:vanilla && npm run chromatic:angular"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
