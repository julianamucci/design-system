{
  "compilerOptions": {
    // O SDK do modelo, importado por docs/shared/chat-docs/servidor.ts, que este
    // projeto passa a checar por causa de `api/`. O arquivo vive no
    // compartilhado, e dali a resolucao nunca entra no node_modules de uma
    // stack — contraparte do `resolve.alias` do vite.
    "paths": {
      "@google/genai": ["./node_modules/@google/genai/dist/genai.d.ts"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.*", "vite.chat-docs.config.ts", "api/**/*.ts", "../scripts/**/*"]
}
