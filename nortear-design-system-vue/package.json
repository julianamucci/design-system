{
  "name": "nortear-design-system-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "pretest": "node ../scripts/limpar-orfaos.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "patch-package",
    "storybook": "npm run chat-docs && storybook dev -p 6007",
    "build-storybook": "npm run chat-docs && storybook build && node ../scripts/generate-seo-files.mjs --base https://vue.norteardesign.com.br --out storybook-static && node ../scripts/minify-html.mjs --out storybook-static",
    "chromatic": "npx chromatic",
    "build-storybook:chromatic": "npm run chat-docs && storybook build",
    "chat-docs": "vite build --config vite.chat-docs.config.ts"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.13.0",
