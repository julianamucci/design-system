{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    // `composite: true` exige que todo arquivo do programa esteja listado; sem
    // isto, importar de @shared/primitives dá TS6307.
    "../docs/shared/primitives/**/*.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../docs/shared/*"]
    }
  }
}
