{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    // `composite: true` exige que todo arquivo do programa esteja listado; sem
    // isto, importar de @shared/primitives dá TS6307.
    "../docs/shared/primitives/**/*.ts",
    // Mesma razão: as stories importam @shared/figma/design-links.
    "../docs/shared/figma/**/*.ts",
    // E as sondas de comparação cross-stack, que medem o mesmo nas quatro.
    "../docs/shared/testing/**/*.ts",
    // E os temas, que o `preview.ts` lê para decidir o tema inicial.
    "../docs/shared/themes/**/*.ts",
    // A pasta do Storybook entra pelo mesmo motivo que `src`: é código que o
    // projeto entrega. É nela que mora o listener de canal da toolbar de tema,
    // e sem ela um erro de tipo ali passava pelo build sem uma palavra.
    ".storybook/**/*.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../docs/shared/*"],
      // Os pacotes npm que o CONTEÚDO COMPARTILHADO importa. O `tsc` resolve do
      // mesmo jeito que o bundler — parte do arquivo em `docs/shared` e SOBE —,
      // então sem estes `paths` ele reprova com TS2307 em código que existe.
      // Contraparte de `resolve.alias` no vite.config; ver o porquê medido em
      // `docs/shared/bundler/alias-pacotes.mjs`.
      "mdast-util-from-markdown": ["./node_modules/mdast-util-from-markdown/index.d.ts"],
      "mdast-util-gfm": ["./node_modules/mdast-util-gfm/index.d.ts"],
      "micromark-extension-gfm": ["./node_modules/micromark-extension-gfm/index.d.ts"]
    }
  }
}
