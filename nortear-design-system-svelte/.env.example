# Copie este arquivo para .env.development E .env.production dentro desta stack,
# preenchendo com o Measurement ID da SUA propriedade GA4 (formato G-XXXXXXXXXX).
# Pode usar IDs diferentes por ambiente (recomendado) ou o mesmo nos dois.
#
# - STORYBOOK_GA_MEASUREMENT_ID: interpolado pelo Storybook no manager-head.html
# - VITE_GA_MEASUREMENT_ID: interpolado pelo Vite no index.html (sandbox dev)
#
# Sem estes arquivos o placeholder nao e substituido e o GA4 fica inativo (no-op).
# Em CI/Vercel, defina STORYBOOK_GA_MEASUREMENT_ID como variavel de ambiente do projeto.
# Ver BRAND-CUSTOMIZATION.md, Etapa 7 - Analytics.
STORYBOOK_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# CHROMATIC_PROJECT_TOKEN: token do projeto no Chromatic (visual regression).
# Fica FORA do chromatic.config.json porque este repositório é público — o
# arquivo de config é versionado. Pegue o token em chromatic.com > Manage.
# Em CI, defina como variável de ambiente/secret do runner.
CHROMATIC_PROJECT_TOKEN=chpt_xxxxxxxxxxxxxxx

# Grafana Faro — observabilidade de front-end (erro, Web Vitals, rede).
# A URL do coletor e client-side e a documentacao do Faro diz que nao e segredo,
# mas este repositorio e publico e a casa ja trata GA4 e Chromatic assim.
# Pegue a URL em Grafana Cloud > Observability > Frontend > seu app.
# Sem esta variavel o Faro e no-op silencioso: quem clona nao manda dado para a
# conta de outra pessoa.
STORYBOOK_FARO_URL=https://faro-collector-prod-<regiao>.grafana.net/collect/<chave>
