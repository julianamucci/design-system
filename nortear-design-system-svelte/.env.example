# Copie este arquivo para .env.development E .env.production dentro desta stack,
# preenchendo com o Measurement ID da SUA propriedade GA4 (formato G-XXXXXXXXXX).
# Pode usar IDs diferentes por ambiente (recomendado) ou o mesmo nos dois.
#
# - STORYBOOK_GA_MEASUREMENT_ID: interpolado pelo Storybook no manager-head.html
# - VITE_GA_MEASUREMENT_ID: interpolado pelo Vite no index.html (sandbox dev)
#
# Sem estes arquivos o placeholder nao e substituido e o GA4 fica inativo (no-op).
# Em CI/Vercel, defina STORYBOOK_GA_MEASUREMENT_ID como variavel de ambiente do projeto.
# Ver BRAND-CUSTOMIZATION.md, Etapa 7 - Analytics.
STORYBOOK_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
