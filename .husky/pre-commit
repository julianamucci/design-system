#!/usr/bin/env sh
# Pre-commit hook — bloqueia padrões que escondem testes quebrados.
# Política do projeto: bugs no primitivo devem ser corrigidos, nunca silenciados.
# Ver CLAUDE.md (raiz) seção "Conventions To Respect".

set -e

FORBIDDEN_PATTERNS='it\.skip|test\.skip|it\.todo|test\.todo|xit\(|xtest\(|xdescribe\(|describe\.skip|expect\.soft|parameters\.a11y\.disable|parameters\.test\.disable'

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(stories|test|spec)\.(ts|tsx|js|jsx|vue|svelte)$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

VIOLATIONS=""
for FILE in $STAGED; do
  ADDED=$(git diff --cached --unified=0 -- "$FILE" | grep -E '^\+[^+]' | grep -E "$FORBIDDEN_PATTERNS" || true)
  if [ -n "$ADDED" ]; then
    VIOLATIONS="$VIOLATIONS\n[$FILE]\n$ADDED\n"
  fi
done

if [ -n "$VIOLATIONS" ]; then
  printf '\n\033[31m✗ Pre-commit blocked: forbidden test-skip patterns detected\033[0m\n'
  printf '%b' "$VIOLATIONS"
  printf '\n\033[33mPolítica do projeto:\033[0m\n'
  printf '  - Nunca usar it.skip / test.skip / it.todo / xit / xdescribe\n'
  printf '  - Nunca usar parameters.a11y.disable ou parameters.test.disable\n'
  printf '  - Nunca usar expect.soft pra mascarar falhas\n'
  printf '  - Se o teste falha, corrija o primitivo. Se o axe acusa, corrija o componente.\n'
  printf '\nPara emergências (ex: bloquear release com bug upstream conhecido), use\n'
  printf '\033[36mgit commit --no-verify\033[0m e abra issue documentando o bypass.\n\n'
  exit 1
fi

exit 0
