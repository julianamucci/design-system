#!/usr/bin/env sh
# Pre-commit hook — dois guardas:
#   1. padrão que esconde teste quebrado (skip, todo, a11y.disable);
#   2. PRD que ficou para trás quando o componente mudou.
# Política do projeto: bugs no primitivo devem ser corrigidos, nunca silenciados.
# Ver CLAUDE.md (raiz) seção "Conventions To Respect".

set -e

# As formas de IDENTIFICADOR levam `\b` à esquerda, e isso não é zelo: sem a
# borda, `xit\(` casa dentro de `focusSafeExit($event)` — medido em 2026-09-07,
# bloqueando um commit legítimo do drawer. `\bit\.skip` pela mesma razão
# (`unit.skip`, `edit.skip`).
#
# É a terceira família de portão desta casa a errar por casar palavra solta: o
# `lista_mais_curta_que_o_conteudo` acusou uma citação dentro de comentário, o
# de nome acessível reprovou num comentário que explicava uma recusa, e o
# `demonstration_labels_divergent` fazia o contrário — SILENCIAVA o achado
# quando a chave era citada em comentário. Aqui o custo é o mais visível dos
# três: o portão impede o trabalho certo, e a saída fácil é renomear o código
# para caber no medidor.
FORBIDDEN_PATTERNS='\bit\.skip|\btest\.skip|\bit\.todo|\btest\.todo|\bxit\(|\bxtest\(|\bxdescribe\(|\bdescribe\.skip|\bexpect\.soft|parameters\.a11y\.disable|parameters\.test\.disable'

ALL_STAGED=$(git diff --cached --name-only --diff-filter=ACM || true)

STAGED=$(printf '%s\n' "$ALL_STAGED" | grep -E '\.(stories|test|spec)\.(ts|tsx|js|jsx|vue|svelte)$' || true)

# ─── PRD que ficou para trás ─────────────────────────────────────────────────
#
# `docs/shared/prd/<slug>.md` descreve o que o componente É hoje, com as
# decisões e a medição de cada uma. Sem gatilho, esse documento apodrece como as
# guidelines que ele existe para consertar — e a única metade que um script
# consegue medir sozinho (token nomeado no PRD que a folha não lê mais) está no
# `audit.mjs`, na regra `prd_token_sem_lastro`.
#
# Esta metade é a outra: o COMMIT é o único momento em que quem editou ainda tem
# o contexto na cabeça. Se o commit mexe na folha, no primitivo ou no conteúdo
# de um componente que tem PRD, o PRD entra junto.
#
# O que este guarda NÃO sabe: se a edição do PRD foi correta. Ele mede atenção,
# não verdade. Um espaço em branco passa — e a defesa contra isso é a seção de
# decisões, que fica ilegível se ninguém a mantiver.
#
# Story, fixture, snippet e teste ficam de fora: eles mudam como o componente é
# DEMONSTRADO, não o que ele é.
#
# Vem ANTES do retorno antecipado do outro guarda de propósito: commit que só
# mexe em CSS não tem arquivo de teste staged e sairia ali, sem passar por aqui.
if [ "$PRD_SKIP" != "1" ]; then
  PRD_PENDENTES=""
  for PRD in docs/shared/prd/*.md; do
    [ -f "$PRD" ] || continue
    SLUG=$(basename "$PRD" .md)
    if [ "$SLUG" = "README" ]; then continue; fi
    if printf '%s\n' "$ALL_STAGED" | grep -qx "$PRD"; then continue; fi

    DESCRITOS=$(printf '%s\n' "$ALL_STAGED" \
      | grep -E "^(docs/shared/styles/nds/${SLUG}\.css|docs/shared/content/${SLUG}/|nortear-design-system-[a-z]+/src/components/ui/${SLUG}[./-])" \
      | grep -vE '\.(stories|fixtures|source|test|spec)\.' || true)

    if [ -n "$DESCRITOS" ]; then
      LISTA=$(printf '%s' "$DESCRITOS" | sed 's/^/      /')
      PRD_PENDENTES="$PRD_PENDENTES\n  \033[1m$SLUG\033[0m — $PRD não entrou, e estes entraram:\n$LISTA\n"
    fi
  done

  if [ -n "$PRD_PENDENTES" ]; then
    printf '\n\033[31m✗ Pre-commit blocked: componente mudou e o PRD ficou para trás\033[0m\n'
    printf '%b' "$PRD_PENDENTES"
    printf '\n\033[33mAntes de commitar, responda as três:\033[0m\n'
    printf '  1. alguma afirmação do CONTRATO mudou? → atualize a linha e o portão que a cobre\n'
    printf '  2. alguma DECISÃO fixada foi revertida? → se de propósito, mova a linha para o\n'
    printf '     histórico com a nova data e a nova medição; se sem querer, é defeito\n'
    printf '  3. algum valor da tabela de TOKENS mudou? → node scripts/tabela-tokens.mjs <slug>\n'
    printf '\nSe a mudança não altera nada do que o PRD afirma (renomear variável interna,\n'
    printf 'corrigir typo de comentário), siga com \033[36mPRD_SKIP=1 git commit …\033[0m — que\n'
    printf 'pula SÓ este guarda. \033[36m--no-verify\033[0m desliga também o de teste silenciado,\n'
    printf 'e não é o caminho para isto.\n\n'
    exit 1
  fi
fi

if [ -z "$STAGED" ]; then
  exit 0
fi

VIOLATIONS=""
for FILE in $STAGED; do
  ADDED=$(git diff --cached --unified=0 -- "$FILE" | grep -E '^\+[^+]' | grep -E "$FORBIDDEN_PATTERNS" || true)
  if [ -n "$ADDED" ]; then
    VIOLATIONS="$VIOLATIONS\n[$FILE]\n$ADDED\n"
  fi
done

if [ -n "$VIOLATIONS" ]; then
  printf '\n\033[31m✗ Pre-commit blocked: forbidden test-skip patterns detected\033[0m\n'
  printf '%b' "$VIOLATIONS"
  printf '\n\033[33mPolítica do projeto:\033[0m\n'
  printf '  - Nunca usar it.skip / test.skip / it.todo / xit / xdescribe\n'
  printf '  - Nunca usar parameters.a11y.disable ou parameters.test.disable\n'
  printf '  - Nunca usar expect.soft pra mascarar falhas\n'
  printf '  - Se o teste falha, corrija o primitivo. Se o axe acusa, corrija o componente.\n'
  printf '\nPara emergências (ex: bloquear release com bug upstream conhecido), use\n'
  printf '\033[36mgit commit --no-verify\033[0m e abra issue documentando o bypass.\n\n'
  exit 1
fi

exit 0
