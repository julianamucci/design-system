  "typography": {
    "font-family": {
      "$value": "'Inter', sans-serif",
      "$type": "fontFamily"
    },
    "font-size-base": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "size": {
      "$description": "Degraus derivados de type-base × type-scale (ver tokens.css)",
      "p": {
        "$value": "calc(var(--type-base))",
        "$type": "dimension"
      },
      "h4": {
        "$value": "calc(var(--text-p) * var(--type-scale))",
        "$type": "dimension"
      },
      "h3": {
        "$value": "calc(var(--text-h4) * var(--type-scale))",
        "$type": "dimension"
      },
      "h2": {
        "$value": "calc(var(--text-h3) * var(--type-scale))",
        "$type": "dimension"
      },
      "h1": {
        "$value": "calc(var(--text-h2) * var(--type-scale))",
        "$type": "dimension"
      },
      "label": {
        "$value": "calc(var(--text-p) / var(--type-scale))",
        "$type": "dimension"
      }
    },
    "weight": {
      "extra-bold": {
        "$value": "800",
        "$type": "fontWeight"
      },
      "semi-bold": {
        "$value": "600",
        "$type": "fontWeight"
      },
      "medium": {
        "$value": "500",
        "$type": "fontWeight"
      },
      "regular": {
        "$value": "400",
        "$type": "fontWeight"
      }
    },
    "line-height": {
      "tight": {
        "$value": "1.2",
        "$type": "number"
      },
      "normal": {
        "$value": "1.5",
        "$type": "number"
      },
      "relaxed": {
        "$value": "1.75",
        "$type": "number"
      },
      "loose": {
        "$value": "2",
        "$type": "number"
      }
    },
    "letter-spacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "normal": {
        "$value": "0em",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.02em",
        "$type": "dimension"
      }
    },
    "type-base": {
      "$value": "1rem",
      "$type": "dimension",
      "$description": "Base do type scale (rem — respeita preferência do navegador). Presets: .base-tipo-s/m/l"
    },
    "type-scale": {
      "$value": "1.2",
      "$type": "number",
      "$description": "Ratio do type scale (Minor Third padrão). Presets: .escala-*"
    }
  },
  "radius": {
    "$description": "Base 10px; escala derivada por offsets fixos; tokens por componente com multiplicadores temáveis",
    "none": {
      "$value": "0",
      "$type": "dimension"
    },
    "base": {
      "$value": "0.625rem",
      "$type": "dimension"
    },
    "xs": {
      "$value": "calc(var(--radius) - 6px)",
      "$type": "dimension"
    },
    "sm": {
      "$value": "calc(var(--radius) - 4px)",
      "$type": "dimension"
    },
    "md": {
      "$value": "calc(var(--radius) - 2px)",
      "$type": "dimension"
    },
    "lg": {
      "$value": "var(--radius)",
      "$type": "dimension"
    },
    "xl": {
      "$value": "calc(var(--radius) + 4px)",
      "$type": "dimension"
    },
    "button": {
      "$value": "var(--radius-lg)",
      "$type": "dimension"
    },
    "input": {
      "$value": "var(--radius-lg)",
      "$type": "dimension"
    },
    "card": {
      "$value": "var(--radius-xl)",
      "$type": "dimension"
    },
    "badge": {
      "$value": "var(--radius-full)",
      "$type": "dimension"
    },
    "alert": {
      "$value": "var(--radius-lg)",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "elevation": {
    "sm": {
      "$value": "0px 1px 2px 0px rgba(0,0,0,0.1)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0px 4px 6px -1px rgba(0,0,0,0.1), 0px 2px 4px -1px rgba(0,0,0,0.06)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0px 10px 15px -3px rgba(0,0,0,0.1), 0px 4px 6px -2px rgba(0,0,0,0.05)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0px 20px 25px -5px rgba(0,0,0,0.1), 0px 10px 10px -5px rgba(0,0,0,0.04)",
      "$type": "shadow"
    }
  },
  "z-index": {
    "dropdown": {
      "$value": "1000",
      "$type": "number"
    },
    "sticky": {
      "$value": "1020",
      "$type": "number"
    },
    "fixed": {
      "$value": "1030",
      "$type": "number"
    },
    "modal-backdrop": {
      "$value": "1040",
      "$type": "number"
    },
    "modal": {
      "$value": "1050",
      "$type": "number"
    },
    "popover": {
      "$value": "1060",
      "$type": "number"
    },
    "tooltip": {
      "$value": "1070",
      "$type": "number"
    }
  }
}
